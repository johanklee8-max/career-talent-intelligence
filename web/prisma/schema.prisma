generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
model User {
 id String @id @default(cuid())
 authSubject String @unique
 createdAt DateTime @default(now())
 careerProfileRecords CareerProfile[]
 educationRecords Education[]
 experienceRecords Experience[]
 skillRecords Skill[]
 documentRecords Document[]
 opportunityRecords Opportunity[]
 companyRecords Company[]
 applicationRecords Application[]
 outreachDraftRecords OutreachDraft[]
 interviewGuideRecords InterviewGuide[]
 executiveSearchCaseRecords ExecutiveSearchCase[]
 candidateRecords Candidate[]
 recommendationRecords Recommendation[]
 feedbackRecords Feedback[]
 auditEventRecords AuditEvent[]
}
model CareerProfile {
 recommendationItems Recommendation[]
 documentItems Document[]
 experienceItems Experience[]
 educationItems Education[]
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 headline String
 summary String
 ambitions String
 skills String[]
 languages String[]
 interests String[]
 preferredLocations String[]
 preferredIndustries String[]
 workPreferences String[]
 @@unique([id, userId])
 @@index([userId])
}
model Education {
 profileId String
 profile CareerProfile @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
 @@index([profileId, userId])
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 institution String
 degree String
 field String?
 @@unique([id, userId])
 @@index([userId])
}
model Experience {
 profileId String
 profile CareerProfile @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
 @@index([profileId, userId])
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 company String
 title String
 description String
 @@unique([id, userId])
 @@index([userId])
}
model Skill {
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 name String
 @@unique([id, userId])
 @@index([userId])
}
model Document {
 profileId String
 profile CareerProfile @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
 @@index([profileId, userId])
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 privateObjectKey String @unique
 mimeType String
 sizeBytes Int
 expiresAt DateTime
 @@unique([id, userId])
 @@index([userId])
}
model Opportunity {
 applicationItems Application[]
 companyId String
 company Company @relation(fields: [companyId, userId], references: [id, userId], onDelete: Cascade)
 @@index([companyId, userId])
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 title String
 location String?
 industry String?
 workArrangement String?
 sourceUrl String?
 verifiedAt DateTime?
 @@unique([id, userId])
 @@index([userId])
}
model Company {
 opportunityItems Opportunity[]
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 name String
 officialUrl String?
 facts Json
 sources Json
 @@unique([id, userId])
 @@index([userId])
}
model Application {
 interviewGuideItems InterviewGuide[]
 outreachDraftItems OutreachDraft[]
 opportunityId String
 opportunity Opportunity @relation(fields: [opportunityId, userId], references: [id, userId], onDelete: Cascade)
 @@index([opportunityId, userId])
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 status String
 followUpAt DateTime?
 @@unique([id, userId])
 @@index([userId])
}
model OutreachDraft {
 applicationId String
 application Application @relation(fields: [applicationId, userId], references: [id, userId], onDelete: Cascade)
 @@index([applicationId, userId])
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 channel String
 body String
 reviewedAt DateTime?
 @@unique([id, userId])
 @@index([userId])
}
model InterviewGuide {
 applicationId String
 application Application @relation(fields: [applicationId, userId], references: [id, userId], onDelete: Cascade)
 @@index([applicationId, userId])
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 content Json
 progress Json
 @@unique([id, userId])
 @@index([userId])
}
model ExecutiveSearchCase {
 candidateItems Candidate[]
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 title String
 mandatoryCriteria String[]
 preferredCriteria String[]
 @@unique([id, userId])
 @@index([userId])
}
model Candidate {
 searchCaseId String
 searchCase ExecutiveSearchCase @relation(fields: [searchCaseId, userId], references: [id, userId], onDelete: Cascade)
 @@index([searchCaseId, userId])
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 displayName String
 evaluation Json
 @@unique([id, userId])
 @@index([userId])
}
model Recommendation {
 profileId String
 profile CareerProfile @relation(fields: [profileId, userId], references: [id, userId], onDelete: Cascade)
 @@index([profileId, userId])
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 role String
 evidence Json
 gaps String[]
 uncertainty String
 @@unique([id, userId])
 @@index([userId])
}
model Feedback {
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 rating Int?
 comment String?
 @@unique([id, userId])
 @@index([userId])
}
model AuditEvent {
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 action String
 resourceId String?
 @@unique([id, userId])
 @@index([userId])
}
